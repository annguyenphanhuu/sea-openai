  "narrative": {
    "northStar": "Chợ Phố operations desk",
    "overview": "The implemented surface inherits Chợ Phố's green and ivory operational identity. Compact rows, restrained status fills and visible separators support repeated comparison; evidence opens directly under its order.",
    "keyCharacteristics": [
      "Green identity with quiet ivory and white surfaces.",
      "Dense, explicitly labelled operational facts.",
      "Flat containers and evidence shown in context."
    ],
    "rules": [
      {
        "name": "The Labelled Status Rule",
        "body": "Every status color is accompanied by a readable status label.",
        "section": "colors"
      },
      {
        "name": "The Separate Dates Rule",
        "body": "Keep the guaranteed date and revised ETA visibly separate at every breakpoint.",
        "section": "layout"
      }
    ],
    "dos": [
      "Do preserve Chợ Phố's green and ivory identity.",
      "Do retain textual status labels and explicit field labels on phones.",
      "Do show evidence in the context of its order."
    ],
    "donts": [
      "Don't merge guaranteed dates and revised estimates into one value.",
      "Don't present evidence inspection as an approval or trust grant.",
      "Don't introduce a new visual identity for this manager surface."
    ]
  }
